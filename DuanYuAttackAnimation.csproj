<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CQBZLY_DUAN_YU_ATTACK_ANIMATION</AssemblyName>
    <RootNamespace>DuanYuAttackAnimation</RootNamespace>
    <Version>1.3.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Sts2Path Condition="'$(Sts2Path)' == ''">D:/steam/steamapps/common/Slay the Spire 2</Sts2Path>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/selection-atlas-*.jpg" LogicalName="DuanYuAttackAnimation.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/combat-*.png" LogicalName="DuanYuAttackAnimation.%(Filename)%(Extension)" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="Set -p:Sts2Path to the Slay the Spire 2 installation or -p:Sts2DataDir to the directory containing sts2.dll, GodotSharp.dll and 0Harmony.dll." />
  </Target>
</Project>
